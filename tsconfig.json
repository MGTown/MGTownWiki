{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],

    "jsx": "preserve",
    "jsxImportSource": "vue",

    "types": ["node"],

    "strict": true,
    "noEmit": true,
    // 允许导入路径带 .ts 扩展名（config.mts 里 import "./nav.ts" 需要）。
    // 该选项仅在 noEmit / emitDeclarationOnly 下可用，本项目为纯类型检查，符合。
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [".vitepress/**/*.ts", ".vitepress/**/*.mts", ".vitepress/**/*.d.ts"],
  "exclude": [".vitepress/cache", ".vitepress/dist"]
}
